# Copy to an untracked, root-owned file on the beta server. Never commit real values.
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
DATABASE_URL=postgres://woordenboom:replace-with-a-long-url-safe-random-password@postgres:5432/woordenboom?sslmode=disable
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_FROM=login@woordenboom.app
# MAILJET_API_KEY and MAILJET_SECRET_KEY come from GitHub beta environment secrets.
